
digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", color="#374151", fillcolor="#F8FAFC", fontname="Noto Sans CJK SC", fontsize=18, margin="0.14,0.10"];
  edge [color="#4B5563", fontname="Noto Sans CJK SC", fontsize=14, arrowsize=0.8];

  ext [label="Host / BMC / OOB / 制造工站\n只负责投递镜像、发起请求、读取状态", fillcolor="#F1F5F9"];
  sec [label="SEC / C908 / FMC / GSP\n启动控制、镜像接收、证明、调试、制造、RMA 编排", fillcolor="#E0F2FE", penwidth=2];
  ehsm [label="eHSM\n验签、解密、密钥、OTP/eFuse、Counter、Lifecycle、Debug Auth", fillcolor="#EEF2FF", penwidth=2];
  otp [label="OTP / eFuse / Key / Counter / Lifecycle\n不可被 Host/OOB 直接访问", fillcolor="#FEF3C7"];
  ext -> sec [label="受控请求 / 受控数据通道"];
  sec -> ehsm [label="Mailbox 安全服务调用"];
  ehsm -> otp [label="安全访问"];
  ext -> ehsm [label="禁止直接访问", style=dashed, color="#DC2626", fontcolor="#DC2626", arrowhead=tee];
  ext -> otp [label="禁止直接访问", style=dashed, color="#DC2626", fontcolor="#DC2626", arrowhead=tee];
}
