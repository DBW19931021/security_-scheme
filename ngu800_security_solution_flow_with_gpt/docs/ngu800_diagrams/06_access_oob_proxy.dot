
digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", color="#374151", fillcolor="#F8FAFC", fontname="Noto Sans CJK SC", fontsize=18, margin="0.14,0.10"];
  edge [color="#4B5563", fontname="Noto Sans CJK SC", fontsize=14, arrowsize=0.8];

  host [label="Host / PCIe\n可投递镜像、读状态", fillcolor="#F1F5F9"];
  bmc [label="BMC / OOB MCU\n可作为管理入口/转发代理", fillcolor="#F1F5F9"];
  firewall [label="Firewall / UserID / DMA 白名单\n地址、读写、安全属性、Master 身份检查", fillcolor="#FEF3C7", penwidth=2];
  stage [label="白名单 Staging Buffer\n允许写入待验证镜像", fillcolor="#DCFCE7"];
  sec [label="SEC / GSP\n解析请求、调用 eHSM、决定 release", fillcolor="#E0F2FE", penwidth=2];
  secure [label="安全域资源\nOTP/eFuse、eHSM、Secure SRAM、Release/Debug 控制寄存器", fillcolor="#EEF2FF", penwidth=2];
  host -> firewall [label="PCIe DMA / MMIO"];
  bmc -> firewall [label="OOB/管理请求"];
  firewall -> stage [label="允许：白名单写入"];
  firewall -> sec [label="允许：受控 doorbell / mailbox"];
  firewall -> secure [label="拒绝直接访问", color="#DC2626", fontcolor="#DC2626", arrowhead=tee];
  bmc -> secure [label="不能越过 SEC/eHSM", style=dashed, color="#DC2626", fontcolor="#DC2626", arrowhead=tee];
  host -> secure [label="不能越权 DMA", style=dashed, color="#DC2626", fontcolor="#DC2626", arrowhead=tee];
}
