
digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", color="#374151", fillcolor="#F8FAFC", fontname="Noto Sans CJK SC", fontsize=18, margin="0.14,0.10"];
  edge [color="#4B5563", fontname="Noto Sans CJK SC", fontsize=14, arrowsize=0.8];

  root [label="Root CA Cert\n验证侧信任锚\nRoot CA 私钥不进设备", fillcolor="#FEF3C7", penwidth=2];
  inter [label="Manufacturer / Intermediate CA\n厂商 HSM/PKI 平台维护", fillcolor="#FFF7ED"];
  devcert [label="Device Attestation Cert\n绑定设备证明公钥、Device ID、产品信息", fillcolor="#DCFCE7"];
  devkey [label="Device Attestation Private Key\n设备安全域内生成/保存，不导出", fillcolor="#EEF2FF", penwidth=2];
  report [label="运行时证明 Report\nnonce + measurement_table + lifecycle + debug + secure boot 状态", fillcolor="#E0F2FE"];
  verifier [label="Host / Verifier\n验证证书链、签名、nonce 和 measurement", fillcolor="#F1F5F9"];
  root -> inter [label="签发/信任"];
  inter -> devcert [label="签发"];
  devkey -> report [label="签名"];
  devcert -> verifier [label="返回证书链"];
  report -> verifier [label="返回证明报告"];
  root -> verifier [label="预置或客户信任库配置", style=dashed];
}
