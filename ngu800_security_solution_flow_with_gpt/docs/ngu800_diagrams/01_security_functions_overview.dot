
digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", color="#374151", fillcolor="#F8FAFC", fontname="Noto Sans CJK SC", fontsize=18, margin="0.14,0.10"];
  edge [color="#4B5563", fontname="Noto Sans CJK SC", fontsize=14, arrowsize=0.8];

  center [label="NGU800 安全方案\n功能范围", shape=ellipse, fillcolor="#E0F2FE", fontsize=22, penwidth=2];
  boot [label="安全启动 / 非安全启动\n固件验签、解密、防回滚", fillcolor="#EEF2FF"];
  identity [label="设备身份与证书链\n远程度量证明", fillcolor="#F0FDFA"];
  mfg [label="制造灌装 / 出厂锁定\nRoot、Key、Cert、Counter", fillcolor="#FFF7ED"];
  lifecycle [label="生命周期 / 调试 / RMA\nTEST、DEVE、MANU、USER、RMA", fillcolor="#FEFCE8"];
  access [label="访问控制与隔离\nFirewall、UserID、DMA 白名单", fillcolor="#FDF2F8"];
  oob [label="Host / BMC / OOB 管理安全\n只投递、只请求、不可越权", fillcolor="#F1F5F9"];
  crypto [label="密码服务与算法策略\n国密 + 国际算法栈", fillcolor="#ECFDF5"];
  audit [label="错误、事件与审计\n启动失败、调试开启、灌装记录", fillcolor="#FAFAFA"];
  center -> boot; center -> identity; center -> mfg; center -> lifecycle;
  center -> access; center -> oob; center -> crypto; center -> audit;
}
