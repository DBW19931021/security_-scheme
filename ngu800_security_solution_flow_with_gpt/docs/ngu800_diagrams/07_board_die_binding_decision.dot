
digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", color="#374151", fillcolor="#F8FAFC", fontname="Noto Sans CJK SC", fontsize=18, margin="0.14,0.10"];
  edge [color="#4B5563", fontname="Noto Sans CJK SC", fontsize=14, arrowsize=0.8];

  info [label="Board / Die 绑定信息\n板卡序列号、Die ID、主从 Die 关系、板级配置", fillcolor="#F1F5F9"];
  sec [label="SEC/GSP 收集并校验\n绑定信息和策略", fillcolor="#E0F2FE", penwidth=2];
  attest [label="路径 A：只进入证明\n写入 attestation report\n由 Host/Verifier 判断是否接受", fillcolor="#DCFCE7"];
  release [label="路径 B：参与启动放行\n绑定不匹配则阻断 GSP/runtime release", fillcolor="#FEE2E2"];
  decision [label="项目组需要拍板\n首版建议：先进入证明；是否阻断 GSP/runtime 另行冻结", fillcolor="#FEF3C7", penwidth=2];
  info -> sec -> attest -> decision;
  sec -> release -> decision;
}
