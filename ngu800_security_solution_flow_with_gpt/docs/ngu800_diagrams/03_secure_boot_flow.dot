digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", color="#374151", fillcolor="#F8FAFC", fontname="Noto Sans CJK SC", fontsize=20, margin="0.16,0.10"];
  edge [color="#4B5563", fontname="Noto Sans CJK SC", fontsize=16, arrowsize=0.8];

  pr [label="1. 上电复位", fillcolor="#F8FAFC"];
  br [label="2. BootROM 最小初始化\n读取 boot mode / lifecycle / secure boot 配置", fillcolor="#E0F2FE"];
  eh [label="3. 拉起 eHSM 并等待 ready\neHSM 完成自检、OTP/密钥恢复", fillcolor="#EEF2FF"];
  fmc_pkg [label="4. BootROM 定位 FMC(SEC1)\n来源：NOR / 本地 Flash", fillcolor="#F1F5F9"];
  fmc_ok [label="5. eHSM 验证 + 解密 FMC\n签名、版本、防回滚、吊销检查", fillcolor="#DCFCE7", penwidth=2];
  fmc [label="6. FMC 启动\n初始化 PCIe / Host 通道", fillcolor="#E0F2FE"];
  host [label="7. Host 投递 GSP(SEC2) / Runtime 镜像\nHost 只负责传输，不负责放行", fillcolor="#F1F5F9"];
  gsp_ok [label="8. SEC 调 eHSM 验证 + 解密 + 测量\nGSP 及后续固件逐项处理", fillcolor="#DCFCE7", penwidth=2];
  gsp [label="9. GSP 进入完整安全控制面\n证明、升级、调试、RMA", fillcolor="#E0F2FE"];
  rel [label="10. Release PM/RAS/OMP/RMP/MMP\n只放行验证通过的固件", fillcolor="#FEF3C7"];
  fail [label="失败路径：任一验证失败\n记录错误并进入恢复/失败处理", fillcolor="#FEE2E2", color="#DC2626"];
  pr -> br -> eh -> fmc_pkg -> fmc_ok -> fmc -> host -> gsp_ok -> gsp -> rel;
  fmc_ok -> fail [label="FAIL", color="#DC2626", fontcolor="#DC2626"];
  gsp_ok -> fail [label="FAIL", color="#DC2626", fontcolor="#DC2626"];
}
