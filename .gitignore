# Temporary outputs
/temp/*
!/temp/.gitkeep
/outputs/tmp/
*.tmp
*.bak
*.swp
*.swo
~*

# IDE
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Generated reports
/reports/generated/

# Local machine state
.local/
.cache/

# Optional local links to confidential or oversized raw files
/source-vault-link/
